<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>📚 Minha Biblioteca</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-100 font-sans text-slate-800 min-h-screen">

  <!-- TELA DE LOGIN/CADASTRO -->
  <div id="telaAuth" class="fixed inset-0 bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 flex items-center justify-center p-5 z-50">
    <div class="bg-white rounded-2xl shadow-2xl p-10 w-full max-w-md">
      <h1 class="text-3xl font-bold text-center text-slate-800 mb-6">📚 Minha Biblioteca</h1>

      <div class="flex bg-slate-100 rounded-xl p-1 mb-6">
        <button id="abaLogin" class="flex-1 py-2.5 rounded-lg font-semibold text-indigo-600 bg-white shadow-sm transition-all">Entrar</button>
        <button id="abaCadastro" class="flex-1 py-2.5 rounded-lg font-semibold text-slate-500 transition-all">Cadastrar</button>
      </div>

      <form id="formLogin" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Email</label>
          <input type="email" id="loginEmail" required
            class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Senha</label>
          <input type="password" id="loginSenha" required
            class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
        </div>
        <button type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg transition-colors">
          Entrar
        </button>
        <p class="erro text-red-500 text-sm text-center min-h-[20px]" id="erroLogin"></p>
      </form>

      <form id="formCadastro" class="space-y-4 hidden">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Nome</label>
          <input type="text" id="cadNome" required
            class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Email</label>
          <input type="email" id="cadEmail" required
            class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Senha (mín. 6 caracteres)</label>
          <input type="password" id="cadSenha" minlength="6" required
            class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
        </div>
        <button type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg transition-colors">
          Criar conta
        </button>
        <p class="erro text-red-500 text-sm text-center min-h-[20px]" id="erroCadastro"></p>
      </form>
    </div>
  </div>

  <!-- APLICAÇÃO -->
  <div id="app" class="hidden">
    <!-- Header -->
    <header class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-xl sm:text-2xl font-bold" id="tituloBiblioteca">📚 Minha Biblioteca</h1>
        <div class="flex items-center gap-2 sm:gap-3">
          <span id="nomeUsuario" class="text-sm opacity-90 hidden sm:inline"></span>
          <button id="btnExportar"
  class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold px-4 py-2 rounded-lg transition-colors text-sm shadow-sm">
  📥 CSV
</button>
          <button id="btnNovo"
            class="bg-white text-indigo-600 hover:bg-indigo-50 font-semibold px-4 py-2 rounded-lg transition-colors text-sm shadow-sm">
            + Novo Livro
          </button>
          <button id="btnSair"
            class="bg-red-500 hover:bg-red-600 text-white font-semibold px-3 py-2 rounded-lg transition-colors text-sm">
            Sair
          </button>
        </div>
      </div>
    </header>

    <!-- Busca e filtros -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <input type="text" id="busca" placeholder="🔍 Buscar por título, autor, gênero ou categoria..."
        class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">

      <div class="flex flex-wrap gap-4 mt-4">
        <div>
          <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Categoria</label>
          <select id="filtroCategoria"
            class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer min-w-[160px]">
            <option value="">Todas</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Ordenar por</label>
          <select id="ordenar"
            class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer min-w-[160px]">
            <option value="recentes">Mais recentes</option>
            <option value="titulo">Título (A-Z)</option>
            <option value="autor">Autor (A-Z)</option>
            <option value="ano">Ano (maior)</option>
            <option value="ano_asc">Ano (menor)</option>
            <option value="categoria">Categoria</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Lista de livros -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
      <div id="lista" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
    </main>
  </div>

  <!-- MODAL -->
  <div id="modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto p-8 relative">
      <button class="fechar absolute top-4 right-4 text-3xl text-slate-400 hover:text-slate-700 leading-none">&times;</button>
      <h2 id="tituloModal" class="text-2xl font-bold text-slate-800 mb-6">Novo Livro</h2>

      <form id="formLivro" class="space-y-4">
        <input type="hidden" id="id">

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Título *</label>
          <input type="text" id="titulo" required
            class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Autor *</label>
          <input type="text" id="autor" required
            class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">ISBN</label>
            <input type="text" id="isbn" placeholder="Ex: 9788595086262"
              class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Ano</label>
            <input type="number" id="ano"
              class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Gênero</label>
            <input type="text" id="genero"
              class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Editora</label>
            <input type="text" id="editora"
              class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Categoria</label>
          <select id="categoria"
            class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer">
            <option value="">Sem categoria</option>
            <option value="Química">Química</option>
            <option value="Física">Física</option>
            <option value="Matemática">Matemática</option>
            <option value="Biologia">Biologia</option>
            <option value="Engenharia">Engenharia</option>
            <option value="Computação">Computação</option>
            <option value="Medicina">Medicina</option>
            <option value="Direito">Direito</option>
            <option value="Literatura">Literatura</option>
            <option value="História">História</option>
            <option value="Outros">Outros</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Capa (imagem)</label>
          <input type="file" id="capa" accept="image/*"
            class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-indigo-50 file:text-indigo-700 file:font-semibold hover:file:bg-indigo-100 cursor-pointer">
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Sinopse</label>
          <textarea id="sinopse" rows="3"
            class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
        </div>

        <button type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg transition-colors">
          Salvar
        </button>
      </form>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>